---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Page Not Found — Glitter Hooves & Fairytails"
  description="That page wandered off. Here's the way back to the farm."
>

<section>
  <div class="container" style="text-align:center; max-width:640px;">
    <div class="cta-emoji">🐐</div>
    <h1 class="section-title">This page wandered off</h1>
    <p class="section-subtitle" style="margin:0 auto 2.5rem;">
      The goats get into everything, and apparently that includes our website. The page you were
      looking for isn't here — but the farm still is.
    </p>
    <div class="hero-buttons" style="justify-content:center;">
      <a href="/" class="btn-primary">Back to the farm</a>
      <a href="/events/" class="btn-secondary">Book a visit</a>
    </div>
    <p class="prose-links" style="margin-top:2.5rem; color:var(--text-muted); font-size:0.95rem;">
      Or head straight to <a href="/about/">our story</a>,
      <a href="/animals/">the animals</a>,
      <a href="/experiences/">farm experiences</a>, or
      <a href="/shop/">the shop</a>.
    </p>
  </div>
</section>

</BaseLayout>
