---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ABOUT_PHOTOS } from '../data/photos.ts';

const [featured, ...rest] = ABOUT_PHOTOS;
---
<BaseLayout title="About — Glitter Hooves & Fairytails" description="The story behind a trauma-informed farm built on kindness, connection, and a little magic.">

<section>
  <div class="container">
    <div class="about-grid">
      <div class="about-text fade-up">
        <span class="section-label">Our Story</span>
        <h1 class="section-title">A magical little farm built on kindness</h1>
        <p>The Journey of Glitter Hooves & Fairy Tails Farm started long before the farm was built.</p>
        <p>For nearly 16 years, I've worked in the child welfare field, including foster care, supporting children and families through difficult and complex situations. Throughout those years, I began noticing the gaps that can exist within traditional systems when it comes to helping children truly feel safe, connected, regulated, and supported.</p>
        <p>While traditional therapies and services are incredibly important, many children — especially those experiencing trauma, neurodivergency, anxiety, emotional overwhelm, or foster care involvement — often benefit from additional supportive environments where they can slow down and simply be children.</p>
        <p>That realization led me to create Gentle Hooves and the experiences we offer here on the farm.</p>
        <p>We are not therapy, and do not replace clinical services. Instead, our programs are built around a therapeutic, trauma-informed model designed to complement traditional supports through connection with animals, nature, creativity, mindfulness, and gentle social experiences.</p>
        <p>Everything we create here is rooted in compassion, emotional safety, inclusion, and the belief that healing and growth can happen in the quiet, meaningful moments too.</p>

        <div class="about-features">
          <div class="feature-pill">🌿 Calming environment</div>
          <div class="feature-pill">🐐 Gentle animals</div>
          <div class="feature-pill">💚 Building confidence & self-esteem</div>
          <div class="feature-pill">👨‍👩‍👧 Family friendly</div>
        </div>
      </div>

      <div class="fade-up about-image-wrap">
        {featured && (
          <Image
            src={featured.src}
            alt={featured.alt}
            width={640}
            densities={[1, 2]}
            format="webp"
            class="about-image"
          />
        )}
        {rest.length > 0 && (
          <div class="about-collage">
            {rest.map(photo => (
              <Image src={photo.src} alt={photo.alt} width={180} densities={[1, 2]} format="webp" />
            ))}
          </div>
        )}
        <div class="about-caption">Built with love, kindness, and a little farm magic ✨</div>
      </div>
    </div>
  </div>
</section>

</BaseLayout>
