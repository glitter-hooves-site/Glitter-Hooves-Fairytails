---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FARM_PHOTOS } from '../data/photos.ts';
---
<BaseLayout title="Glitter Hooves & Fairytails" description="A peaceful farm where dreams grow and magic roams free.">

<section class="hero hero-centered">
  <div class="hero-content">
    <div>
      <div class="hero-badge">✨ Welcome to Our Farm!</div>
      <h1>Where Dreams Grow<br />and <em>Magic Roams Free</em></h1>
      <p>A Soft Place for Little Hearts to Land.</p>
      <p>Rooted in Compassion, Connection, & a Little Magic.</p>
      <div class="hero-buttons">
        <a href="/events/" class="btn-primary">Book a Visit</a>
        <a href="/about/" class="btn-secondary">Learn More</a>
      </div>
    </div>
  </div>
</section>

<section class="photo-scroll">
  <h2>Life on the Farm</h2>
  <div class="scroll-track">
    {FARM_PHOTOS.map(photo => (
      <img src={photo.src} alt={photo.alt} />
    ))}
  </div>
</section>

</BaseLayout>
