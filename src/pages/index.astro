---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Glitter Hooves & Fairytails" description="A peaceful farm where dreams grow and magic roams free.">

<section class="hero">
  <div class="hero-content">
    <div>
      <div class="hero-badge">✨ Welcome to Our Farm!</div>
      <h1>Where Dreams Grow<br />and <em>Magic Roams Free</em></h1>
      <p>A Soft Place for Little Hearts to Land.</p>
      <p>Rooted in Compassion, Connection, & a Little Magic.</p>
      <div class="hero-buttons">
        <a href="/events/" class="btn-primary">Book a Visit</a>
        <a href="/about/" class="btn-secondary">Learn More</a>
      </div>
    </div>
    <div class="hero-image-stack">
      <img src="/images/petunia.jpg" alt="Petunia the goat" class="hero-img-main" />
      <img src="/images/piper.jpg" alt="Piper the goat" class="hero-img-accent" />
      <div class="hero-tag">
        <div class="hero-tag-dot"></div>
        Open for visits
      </div>
    </div>
  </div>
</section>

<section class="photo-scroll">
  <h2>Life on the Farm</h2>
  <div class="scroll-track">
    <img src="/images/petunia and piper.jpeg" alt="Butt heads at play" />
    <img src="/images/piper and emma.jpeg" alt="Happiness is a small goat" />
  </div>
</section>

</BaseLayout>
