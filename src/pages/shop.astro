---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Shop — Hooves & Handmade Farm Shop" description="Farm-inspired gifts, fairy treasures, sensory-friendly activities, and handmade creations. Every purchase supports our farm programs.">

<section>
  <div class="container">
    <div class="section-header fade-up" style="text-align:center;">
      <span class="section-label">Hooves and Handmade Farm Shop</span>
      <h2 class="section-title">Visit Our Store</h2>
      <p class="section-subtitle" style="margin:auto;">
        Welcome to the Glitter Hooves & Fairytails Farm 'Hooves & Handmade' farm shop, where every item is chosen with a little farm magic and a lot of heart.
        Our store features farm-inspired gifts, fairy treasures, sensory-friendly activities, positive affirmation products, event merchandise, seasonal items, and handmade creations designed for children, families, and anyone who loves life on a farm.
        More than just a store, every purchase helps support our animals and the programs we offer through Glitter Hooves & Fairytails Farm, including neurodivergent-friendly experiences, foster care support initiatives, homeschool opportunities, community events, and therapeutic, trauma-informed programming.
      </p>
    </div>

    <div class="cta-card alt fade-up">
      <div class="cta-emoji">🛍️</div>
      <p>Thank you for supporting our small farm and helping us create a place where children can explore, connect, and grow — one gentle hoofprint at a time.</p>
      <a href="https://glitterhoovesfairytails.lovable.app/" target="_blank" rel="noopener noreferrer" class="btn-primary">Shop Now ✨</a>
    </div>
  </div>
</section>

</BaseLayout>
