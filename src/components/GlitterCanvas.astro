---
---
<canvas id="glitter-canvas" style="position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:999;"></canvas>

<script>
  const canvas = document.getElementById('glitter-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
  window.addEventListener('resize', () => { canvas.width = window.innerWidth; canvas.height = window.innerHeight; });

  const COLORS = ['#f9d97a','#f7b2d9','#a8d8b9','#fce4b3','#d4b8f0','#f9e4c8','#b8e0f7','#ffd6e0'];
  const particles: Glitter[] = [];

  class Glitter {
    x: number; y: number; size: number; speedX: number; speedY: number;
    color: string; alpha: number; decay: number; rotation: number; rotSpeed: number; shape: string;
    constructor(x?: number, y?: number, burst?: boolean) {
      this.x = x ?? Math.random() * canvas.width;
      this.y = y ?? -10;
      this.size = burst ? (Math.random() * 5 + 2) : (Math.random() * 3 + 1);
      this.speedX = burst ? (Math.random() - 0.5) * 6 : (Math.random() - 0.5) * 0.8;
      this.speedY = burst ? (Math.random() * 4 + 1) : (Math.random() * 1.2 + 0.3);
      this.color = COLORS[Math.floor(Math.random() * COLORS.length)];
      this.alpha = burst ? 1 : Math.random() * 0.7 + 0.3;
      this.decay = burst ? 0.018 : 0.004;
      this.rotation = Math.random() * Math.PI * 2;
      this.rotSpeed = (Math.random() - 0.5) * 0.15;
      this.shape = Math.random() > 0.5 ? 'star' : 'rect';
    }
    update() {
      this.x += this.speedX;
      this.y += this.speedY;
      this.alpha -= this.decay;
      this.rotation += this.rotSpeed;
    }
    draw() {
      ctx.save();
      ctx.globalAlpha = Math.max(0, this.alpha);
      ctx.fillStyle = this.color;
      ctx.translate(this.x, this.y);
      ctx.rotate(this.rotation);
      if (this.shape === 'star') {
        ctx.beginPath();
        for (let i = 0; i < 5; i++) {
          const angle = (i * 4 * Math.PI) / 5 - Math.PI / 2;
          ctx.lineTo(Math.cos(angle) * this.size, Math.sin(angle) * this.size);
          if (i < 4) {
            const ia = angle + (2 * Math.PI) / 5;
            ctx.lineTo(Math.cos(ia) * this.size * 0.4, Math.sin(ia) * this.size * 0.4);
          }
        }
        ctx.closePath();
        ctx.fill();
      } else {
        ctx.fillRect(-this.size / 2, -this.size / 2, this.size, this.size * 0.5);
      }
      ctx.restore();
    }
  }

  function spawnAmbient() {
    if (particles.length < 60) particles.push(new Glitter());
  }

  document.addEventListener('click', (e) => {
    for (let i = 0; i < 28; i++) particles.push(new Glitter(e.clientX, e.clientY, true));
  });

  function animate() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    spawnAmbient();
    for (let i = particles.length - 1; i >= 0; i--) {
      particles[i].update();
      particles[i].draw();
      if (particles[i].alpha <= 0 || particles[i].y > canvas.height + 20) particles.splice(i, 1);
    }
    requestAnimationFrame(animate);
  }
  animate();
</script>
