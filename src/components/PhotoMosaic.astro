---
import { Image, getImage } from 'astro:assets';
import type { Photo } from '../data/photos.ts';

interface Props {
  photos: Photo[];
  /** Columns on a wide screen. Narrower screens step down automatically. */
  columns?: 3 | 4;
}

const { photos, columns = 3 } = Astro.props;

// The grid tile is small, but tapping a photo opens it full-screen, so each
// one also gets a large rendition. Capped at the source width — sharp would
// otherwise upscale a small original and ship a bigger, blurrier file.
const items = await Promise.all(
  photos.map(async photo => ({
    ...photo,
    full: (await getImage({ src: photo.src, width: Math.min(1600, photo.src.width), format: 'webp' })).src,
  })),
);
---
<div class={`mosaic mosaic-${columns}`}>
  {items.map((photo, i) => (
    <button type="button" class="mosaic-item" data-index={i} data-full={photo.full} aria-label={`View larger: ${photo.alt}`}>
      <!-- Masonry columns keep each photo's own shape; nothing is cropped. -->
      <Image src={photo.src} alt={photo.alt} width={400} densities={[1, 2]} format="webp" />
    </button>
  ))}
</div>

<dialog class="lightbox" aria-label="Photo viewer">
  <img class="lightbox-img" alt="" />
  <button type="button" class="lightbox-close" aria-label="Close">✕</button>
  <button type="button" class="lightbox-prev" aria-label="Previous photo">‹</button>
  <button type="button" class="lightbox-next" aria-label="Next photo">›</button>
</dialog>

<script>
  // One viewer per mosaic. <dialog> gives us Escape-to-close, focus
  // trapping and the backdrop for free.
  document.querySelectorAll<HTMLElement>('.mosaic').forEach(mosaic => {
    const dialog = mosaic.nextElementSibling as HTMLDialogElement;
    const img = dialog.querySelector<HTMLImageElement>('.lightbox-img')!;
    const items = [...mosaic.querySelectorAll<HTMLButtonElement>('.mosaic-item')];
    let index = 0;

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      img.src = items[index].dataset.full!;
      img.alt = items[index].querySelector('img')!.alt;
    };

    items.forEach((item, i) => item.addEventListener('click', () => {
      show(i);
      dialog.showModal();
    }));
    dialog.querySelector('.lightbox-close')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('.lightbox-prev')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('.lightbox-next')!.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('keydown', e => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    // Clicking the dark area around the photo closes it.
    dialog.addEventListener('click', e => { if (e.target === dialog) dialog.close(); });
  });
</script>
