---
import { EVENTS, eventMonthLabel, eventDayLabel, toISODate, FARM_LOCATION } from '../data/events.ts';

// Event schema JSON-LD — only for events with a real date, so search
// engines can surface them as rich results.
const eventJsonLd = EVENTS
  .filter(ev => ev.date)
  .map(ev => ({
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: ev.title,
    startDate: toISODate(ev.date!),
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    eventStatus: 'https://schema.org/EventScheduled',
    location: (loc => ({
      '@type': 'Place',
      name: loc.name,
      address: {
        '@type': 'PostalAddress',
        ...(loc.street ? { streetAddress: loc.street } : {}),
        addressLocality: loc.locality,
        addressRegion: loc.region,
        ...(loc.postalCode ? { postalCode: loc.postalCode } : {}),
        addressCountry: 'US',
      },
    }))(ev.location ?? FARM_LOCATION),
    ...(ev.rsvpUrl ? { url: ev.rsvpUrl } : {}),
  }));
---
{eventJsonLd.map(ld => (
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
))}
<div class="events-layout">
  <div class="event-list fade-up">
    {EVENTS.map(ev => {
      const free = ev.price === 'Free';
      const month = eventMonthLabel(ev);
      const day = eventDayLabel(ev);
      return (
        <div class="event-item" id={ev.slug}>
          <div class="event-date-box">
            <div class="month">{month}</div>
            {day && <div class="day">{day}</div>}
          </div>
          <div class="event-info">
            <h2>{ev.title}</h2>
            <p>🕐 {ev.time} &nbsp;·&nbsp; 📍 {(ev.location ?? FARM_LOCATION).name}</p>
          </div>
          <div class="event-meta">
            <span class={`event-badge ${free ? 'badge-free' : 'badge-paid'}`}>{ev.price}</span>
            {ev.rsvpUrl && (
              <a class="btn-rsvp" href={ev.rsvpUrl} target="_blank" rel="noopener noreferrer">RSVP</a>
            )}
            <span class="event-seats">{ev.seats}</span>
          </div>
        </div>
      );
    })}
  </div>

  <div class="booking-card fade-up">
    <h2>Reserve Farm Connection Visit</h2>
    <p>Fill out the form and we'll confirm your reservation within 24 hours.</p>
    <form id="bookingForm" action="https://formspree.io/f/maqavneq" method="POST" novalidate>
      <input type="hidden" name="event" value="Farm Connection Visit" />
      <div class="form-row">
        <div class="form-group">
          <label>First Name</label>
          <input type="text" id="fname" name="first_name" placeholder="Jane" />
          <span class="field-error" id="fname-err">Please enter your first name.</span>
        </div>
        <div class="form-group">
          <label>Last Name</label>
          <input type="text" id="lname" name="last_name" placeholder="Smith" />
          <span class="field-error" id="lname-err">Please enter your last name.</span>
        </div>
      </div>
      <div class="form-group">
        <label>Email</label>
        <input type="email" id="email" name="email" placeholder="you@email.com" />
        <span class="field-error" id="email-err">Please enter a valid email address.</span>
      </div>
      <div class="form-group">
        <label>Phone</label>
        <input type="tel" id="phone" name="phone" placeholder="(555) 000-0000" />
        <span class="field-error" id="phone-err">Please enter a valid phone number.</span>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Number of Adults</label>
          <select id="adults" name="adults">
            <option value="">Select…</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5+">5+</option>
          </select>
          <span class="field-error" id="adults-err">Please select the number of adults.</span>
        </div>
        <div class="form-group">
          <label>Number of Children</label>
          <select id="children" name="children">
            <option value="">Select…</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5+">5+</option>
          </select>
          <span class="field-error" id="children-err">Please select the number of children.</span>
        </div>
      </div>
      <div class="form-group">
        <label>Message</label>
        <textarea id="message" name="message" placeholder="Day(s) you'd like to visit, special needs, etc."></textarea>
        <span class="field-error" id="message-err">Please share a few details so we can plan your visit.</span>
      </div>
      <button type="button" class="btn-book" id="bookingSubmit">Request Reservation ✨</button>
      <p class="booking-note">We'll follow up by email to confirm and arrange payment.</p>
    </form>
    <div class="success-message" id="successMsg">
      🌿 Thank you! We've received your request and will be in touch within 24 hours.
    </div>
  </div>
</div>

<script>
  // Shared links land as /events/#teen-reset. Getting the visitor onto the
  // right row is fiddlier than it looks: the browser's own jump fires before
  // stylesheets, webfonts and the fade-up animation have finished reflowing
  // the page, and every one of those invalidates an earlier scroll. Measured
  // here, a single early jump landed 443px short on mobile and the row it was
  // meant to highlight was off screen.
  //
  // So rather than guess which reflow is the last one, re-apply on a short
  // bounded schedule and stop as soon as the visitor takes over.
  function jumpToHashedEvent() {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    document.getElementById(id)?.scrollIntoView({ block: 'start', behavior: 'instant' });
  }

  if (location.hash) {
    // Arriving on a hash means the link decides where we land, not the back
    // button. Left on 'auto' the browser restores this URL's previous scroll
    // position and silently overrides the jump.
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';

    let tries = 0;
    const settle = setInterval(() => {
      jumpToHashedEvent();
      if (++tries >= 12) clearInterval(settle);
    }, 100);
    const stop = () => clearInterval(settle);
    // Never fight someone who has started scrolling for themselves.
    ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach(e =>
      window.addEventListener(e, stop, { once: true, passive: true }));
    window.addEventListener('load', jumpToHashedEvent);
  }

  // Changing hash on an already-loaded page is a same-document navigation, so
  // none of the above re-runs. Layout is settled by then, so one jump is enough.
  window.addEventListener('hashchange', jumpToHashedEvent);
</script>

<script>
  type Field = HTMLInputElement | HTMLSelectElement;
  const $ = (id: string) => document.getElementById(id) as Field | null;

  const setError = (field: Field | null, errId: string, bad: boolean) => {
    if (!field) return;
    field.classList.toggle('invalid', bad);
    document.getElementById(errId)?.classList.toggle('visible', bad);
  };

  document.getElementById('bookingSubmit')?.addEventListener('click', async () => {
    const fname = $('fname')!;
    const lname = $('lname')!;
    const email = $('email')!;
    const phone = $('phone')!;
    const adults = $('adults')!;
    const children = $('children')!;
    const message = document.getElementById('message') as HTMLTextAreaElement;

    const fnameBad = !fname.value.trim();
    const lnameBad = !lname.value.trim();
    const emailBad = !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim());
    const phoneVal = phone.value.trim();
    const phoneBad = !!phoneVal && !/^[\d\s\-\(\)\+]{7,15}$/.test(phoneVal);
    const adultsBad = !adults.value;
    const childrenBad = !children.value;
    const messageBad = !message.value.trim();

    setError(fname, 'fname-err', fnameBad);
    setError(lname, 'lname-err', lnameBad);
    setError(email, 'email-err', emailBad);
    setError(phone, 'phone-err', phoneBad);
    setError(adults, 'adults-err', adultsBad);
    setError(children, 'children-err', childrenBad);
    message.classList.toggle('invalid', messageBad);
    document.getElementById('message-err')?.classList.toggle('visible', messageBad);

    if (fnameBad || lnameBad || emailBad || phoneBad || adultsBad || childrenBad || messageBad) return;

    const form = document.getElementById('bookingForm') as HTMLFormElement;
    const submitBtn = document.getElementById('bookingSubmit') as HTMLButtonElement;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending…';

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(`Form submission failed: ${res.status}`);
      form.style.display = 'none';
      document.getElementById('successMsg')?.classList.add('show');
    } catch (err) {
      console.error(err);
      submitBtn.disabled = false;
      submitBtn.textContent = 'Request Reservation ✨';
      alert("Sorry — something went wrong sending your request. Please try again, or email us directly.");
    }
  });
</script>
